# Copy to backend/.env for local development; never commit the copy.
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=septa
SITE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECRET_KEY=generate-a-unique-32-character-minimum-secret
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-unique-password-12-chars
