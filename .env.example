# Email (required for production enquiry delivery)
RESEND_API_KEY=
FROM_EMAIL=
ADMIN_NOTIFY_EMAIL=

# Media (required for production uploads)
STORAGE_PROVIDER=LOCAL
BUCKET_NAME=septa-media
PUBLIC_CDN_BASE_URL=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=
LOCAL_UPLOAD_DIR=./backend/uploads
FRONTEND_BUILD_DIR=./frontend/build
