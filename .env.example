# Runtime
APP_ENV=development
SITE_URL=http://localhost:8000
ALLOW_INDEXING=false
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
SECRET_KEY=generate-a-unique-32-character-minimum-secret
MONGO_URL=mongodb://localhost:27017
DB_NAME=septa
BOOTSTRAP_ADMIN_EMAIL=paul@septa.one
BOOTSTRAP_ADMIN_PASSWORD=

# Local default: password. Production requires Google Workspace sign-in.
ADMIN_AUTH_MODE=password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=septa.one

# Email (required for production enquiry delivery)
RESEND_API_KEY=
FROM_EMAIL=Septa Group <contact@septa.one>
ADMIN_NOTIFY_EMAIL=paul@septa.one

# Media (required for production uploads)
STORAGE_PROVIDER=LOCAL
BUCKET_NAME=septa-media
PUBLIC_CDN_BASE_URL=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT_URL=
LOCAL_UPLOAD_DIR=./backend/uploads
FRONTEND_BUILD_DIR=./frontend/build

# Optional second step for local password sign-in; production uses Workspace.
ADMIN_EMAIL_OTP=false
